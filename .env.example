# =============================================================================
# B2B Order Intake Prototype - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running docker compose up.
# All thresholds, limits, intervals, and behavioural toggles are set here.
# Nothing is hardcoded in the pipeline.
# =============================================================================

# -----------------------------------------------------------------------------
# AI / Anthropic
# -----------------------------------------------------------------------------

# Your Anthropic API key - required
#ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Which AI model to use for extraction and resolution
# Default: claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Adapter Selection
# All adapters are selected here. The pipeline never imports an adapter directly.
# Changing these values swaps the implementation - no code changes required.
# -----------------------------------------------------------------------------

# AI extraction provider - which service performs order extraction
# Options: claude
EXTRACTION_PROVIDER=claude

# SKU resolver - which service resolves unrecognised buyer SKUs
# Options: claude
SKU_RESOLVER=claude

# ERP adapter - which system receives submitted orders
# Options: stub
# Add: netsuite, sap, dynamics365 (future implementations)
ERP_ADAPTER=stub

# Logging adapter - where pipeline events are written
# Options: postgres
# Add: datadog, cloudwatch (future implementations)
LOGGING_ADAPTER=postgres

# Customer lookup adapter - where customer records are read from
# Options: json (config/customers.json)
# Add: salesforce, netsuite-crm (future implementations)
CUSTOMER_LOOKUP=json

# Inbound channel adapters - comma-separated list
# Options: email, edi
CHANNEL_ADAPTERS=email,edi

# Notification adapter - controls the outbound notification mechanism
# Options: email
NOTIFICATION_ADAPTER=email

# -----------------------------------------------------------------------------
# Confidence Thresholds
# All values are percentages (0-100). Adjust without changing pipeline code.
# -----------------------------------------------------------------------------

# Overall extraction confidence at or above this value -> eligible for ERP submission
# Confidence at or below this value -> document is treated as unreadable (triggers "couldn't read" reply)
CONFIDENCE_UNREADABLE_THRESHOLD=5

CONFIDENCE_SUBMIT_THRESHOLD=70

# Overall extraction confidence below this value -> Human Review regardless of other checks
CONFIDENCE_REVIEW_THRESHOLD=50

# AI SKU match at or above this score -> auto-resolved (substitution noted in audit log)
SKU_AUTO_THRESHOLD=90

# AI SKU match below this score -> Seek Clarification
# Between SKU_REVIEW_THRESHOLD and SKU_AUTO_THRESHOLD -> Human Review
SKU_REVIEW_THRESHOLD=50

# When true: any order where AI fuzzy matching was used to resolve a SKU
# goes to Human Review regardless of confidence score
# When false: confidence thresholds above govern the outcome
SKU_FUZZY_ALWAYS_REVIEW=false

# AI customer match at or above this score at cascade step 4 -> auto-identified
CUSTOMER_AUTO_THRESHOLD=90

# AI customer match below this score -> Seek Clarification or Reject
# Between CUSTOMER_REVIEW_THRESHOLD and CUSTOMER_AUTO_THRESHOLD -> Human Review
CUSTOMER_REVIEW_THRESHOLD=60

# When true: any order where AI fuzzy matching was used to identify the customer
# goes to Human Review regardless of confidence score
CUSTOMER_FUZZY_ALWAYS_REVIEW=false

# -----------------------------------------------------------------------------
# Processing Limits & Behaviour
# -----------------------------------------------------------------------------

# Days back to check for duplicate PO number + customer account ID combination
# Set to 0 to disable duplicate detection
DUPLICATE_PO_WINDOW_DAYS=30

# When true: backorderable items auto-submit with backorder_eta in ERP payload
# When false: backorderable items route to Human Review
BACKORDER_AUTO_SUBMIT=true

# Maximum number of line items per order
# Orders exceeding this limit route to Human Review
MAX_LINE_ITEMS=100

# Minimum character count for extracted PDF text
# PDFs below this threshold are treated as likely scanned - low confidence
PDF_MIN_TEXT_LENGTH=50

# Maximum number of SKU candidates returned by the AI resolver per line item
SKU_MAX_CANDIDATES=3

# Maximum number of customer candidates returned by the AI fuzzy matcher
CUSTOMER_MAX_CANDIDATES=3

# How often the email channel polls for new inbound messages (milliseconds)
INBOUND_MAIL_POLL_INTERVAL_MS=5000
EDI_POLL_INTERVAL_MS=2000

# Maximum time (ms) the graph is allowed to run before the channel gives up on it
# Prevents a hanging Claude call from blocking the poll loop indefinitely
GRAPH_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://b2border:b2border@postgres:5432/b2border

# -----------------------------------------------------------------------------
# Service URLs (internal Docker networking)
# These are used by services when communicating with each other inside Docker.
# Do not change unless you rename Docker services.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Mail provider configuration - uncomment ONE block below (Mailpit OR SendGrid)
# -----------------------------------------------------------------------------
#
# --- Option A: Mailpit (local dev - no external accounts needed) ---
# Mailpit runs as a Docker container, catching all outbound mail locally.
# Inbound orders are injected via the Mailpit web UI or SMTP.
#
INBOUND_MAIL_PROVIDER=mailpit
EMAIL_PROVIDER=mailpit
INBOUND_MAIL_API_URL=http://mailpit:8025
EMAIL_VIEWER_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
PIPELINE_NOTIFICATION_FROM=b2b-intake@localhost
INTAKE_EMAIL_ADDRESS=orders@b2b-intake.local
INQUIRY_CONTACT_EMAIL=sales@b2b-intake.local
#SENDGRID_API_KEY=
#SENDGRID_FROM_EMAIL=
#
# --- Option B: SendGrid (production - real inbound + outbound email) ---
# SendGrid Inbound Parse POSTs inbound email to POST /api/v1/email/inbound.
# Outbound clarification replies are sent via SendGrid transactional API.
# Prerequisites:
#   1. Verified sender domain in SendGrid
#   2. Inbound Parse webhook URL set to: https://<your-host>/api/v1/email/inbound
#   3. MX record for your inbound subdomain pointing to mx.sendgrid.net
# Note: INBOUND_MAIL_API_URL, EMAIL_VIEWER_PORT, SMTP_HOST, SMTP_PORT are not used with SendGrid.
#
#INBOUND_MAIL_PROVIDER=sendgrid
#EMAIL_PROVIDER=sendgrid
#PIPELINE_NOTIFICATION_FROM=orders@yourdomain.com
#INTAKE_EMAIL_ADDRESS=orders@yourdomain.com
#INQUIRY_CONTACT_EMAIL=sales@yourdomain.com
#SENDGRID_API_KEY=SG.your-key-here
#SENDGRID_FROM_EMAIL=orders@yourdomain.com

ERP_STUB_URL=http://erp-stub:3001

# -----------------------------------------------------------------------------
# External Ports
# These control which host ports each service is accessible on.
# Change if you have port conflicts on your machine.
# -----------------------------------------------------------------------------

# Agent Control Interface - open http://localhost:3000
AGENT_UI_PORT=3000

# ERP Stub REST API - open http://localhost:3001/orders
ERP_STUB_PORT=3001

# Pipeline API - open http://localhost:3002/health
PIPELINE_PORT=3002

# Email inbox viewer - host port that maps to the Mailpit container's web UI port
# Referenced in docker-compose.yml; EMAIL_VIEWER_PORT in config.js is what the pipeline uses
MAILPIT_WEB_PORT=8025

# -----------------------------------------------------------------------------
# EDI outbound adapter - controls how outbound 864/855 documents are transmitted
# Options: file (write to EDI_OUTBOUND_PATH directory)
# Add: van (Value Added Network API), as2 (direct AS2 transmission)
EDI_OUTBOUND_PROVIDER=file

# EDI File Paths (absolute paths inside the pipeline container)
# Bind-mounted from the host via docker-compose.yml.
# Must be absolute so they resolve correctly regardless of working directory.
# -----------------------------------------------------------------------------

# Drop EDI files here to trigger processing
EDI_INBOX_PATH=/app/edi-inbox

# Files that cause pipeline errors are moved here for inspection
EDI_ERROR_PATH=/app/edi-error

# Outbound EDI replies (864 clarifications, 855 rejections) are written here
EDI_OUTBOUND_PATH=/app/edi-outbound

# (SendGrid credentials and email identity are configured in the provider block above)

# -----------------------------------------------------------------------------
# API Behaviour
# -----------------------------------------------------------------------------

# Set to false in production to disable /api/v1/test/* endpoints (clear, run, manifest, preview)
# These endpoints truncate the database and inject test data - never expose in production
ENABLE_TEST_ENDPOINTS=true

# Global API rate limit - max requests per minute per IP across all /api/v1 routes
API_RATE_LIMIT=100

# Max test/run calls per minute per IP (default 120 - high enough for Run All on the full 52-test corpus)
TEST_RUN_RATE_LIMIT=120

# AI call resilience - retry settings for transient Claude API failures
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000

# Maximum number of orders shown in the Live Feed
LIVE_FEED_LIMIT=100

# Structured log level - trace | debug | info | warn | error | fatal
LOG_LEVEL=info
